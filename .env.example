# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CREDENTIALS_PATH=/path/to/your/service-account-key.json

# Alternative: You can use the standard Google Cloud environment variable
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Environment Configuration
ENVIRONMENT=development

# Optional: Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=finance_user
DB_PASSWORD=your-db-password
DB_NAME=financial_news_db

# Optional: Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: API Keys for other services
OPENAI_API_KEY=your-openai-api-key
BLOOMBERG_API_KEY=your-bloomberg-api-key

# Optional: Monitoring and Logging
SENTRY_DSN=your-sentry-dsn
JWT_SECRET_KEY=your-jwt-secret-key

# Slack/Discord webhooks for alerts
SLACK_WEBHOOK_URL=your-slack-webhook-url
DISCORD_WEBHOOK_URL=your-discord-webhook-url